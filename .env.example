# ============================================================
# Product Discovery — zmienne środowiskowe
# ============================================================
# Skopiuj ten plik jako .env i uzupełnij wartości.
# UWAGA: Zalecana konfiguracja przez UI Settings (Settings page)
#        zapisuje dane do ~/.product-discovery/config.json
#        Ten plik służy jako fallback lub dla deploymentów Docker.
# ============================================================

# Required: Anthropic Claude API key
# Pobierz na: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional: Perplexity API — lepsza jakość OSINT research
# Pobierz na: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_perplexity_key_here

# Optional: Serper.dev — Google Search results
# Pobierz na: https://serper.dev
SERPER_API_KEY=your_serper_key_here

# Optional: Exa.ai — neural semantic search
# Pobierz na: https://exa.ai
EXA_API_KEY=your_exa_key_here

# Optional: Brave Search API
# Pobierz na: https://api.search.brave.com
BRAVE_API_KEY=your_brave_key_here

# Optional: Miro integration
# Pobierz token na: https://miro.com/app/settings/user-profile/apps
# Board ID znajdziesz w URL tablicy Miro
MIRO_ACCESS_TOKEN=your_miro_token_here
MIRO_BOARD_ID=your_miro_board_id_here

# Optional: Slack Webhook (bez OAuth)
# Utwórz Webhook na: https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Optional: Google OAuth2 (dla eksportu do Google Docs)
# Utwórz projekt na: https://console.cloud.google.com
# Włącz: Google Docs API + Google Drive API
# Utwórz OAuth2 credentials (Desktop app), pobierz client_id i client_secret
# Dodaj redirect URI: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# Optional: Folder danych użytkownika (domyślnie ~/product-discovery-data)
# DATA_DIR=/path/to/your/data/folder

# Development: Mock mode — discovery bez LLM (~3s, $0)
# DISCOVERY_MOCK=true
