{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Product Builder Design Tokens — machine-readable format",
  "brand": {
    "name": "Product Builder (Product Discovery)",
    "version": "1.0.0"
  },
  "colors": {
    "brand": {
      "teal-100": { "value": "#CCFBF1", "description": "Focus bg, ghost btn bg, badge solution" },
      "teal-400": { "value": "#2DD4BF", "description": "Hover on primary button" },
      "teal-500": { "value": "#14B8A6", "description": "Primary accent — CTA, active nav, focus ring" },
      "teal-600": { "value": "#0D9488", "description": "Ghost btn text, secondary hover" }
    },
    "neutral": {
      "sidebar": { "value": "#0D2535", "description": "Sidebar bg, primary dark text" },
      "dark-800": { "value": "#1C2E40", "description": "Secondary dark bg" },
      "dark-950": { "value": "#0D1117", "description": "Body dark mode alt" }
    },
    "semantic": {
      "success": { "value": "#10B981", "description": "Success states" },
      "warning": { "value": "#F59E0B", "description": "Warning, queued" },
      "danger":  { "value": "#EF4444", "description": "Error, destructive" },
      "info":    { "value": "#3B82F6", "description": "Information, links" },
      "orange":  { "value": "#F97316", "description": "Problem mode" },
      "violet":  { "value": "#8B5CF6", "description": "Auto mode" }
    },
    "semantic-pairs": {
      "success-bg": { "value": "#DCFCE7" },
      "success-text": { "value": "#15803D" },
      "success-border": { "value": "#86EFAC" },
      "warning-bg": { "value": "#FEF3C7" },
      "warning-text": { "value": "#B45309" },
      "warning-border": { "value": "#FDE68A" },
      "danger-bg": { "value": "#FEE2E2" },
      "danger-text": { "value": "#DC2626" },
      "danger-border": { "value": "#FCA5A5" },
      "info-bg": { "value": "#EFF6FF" },
      "info-text": { "value": "#3B82F6" },
      "orange-bg": { "value": "#FFF7ED" },
      "orange-text": { "value": "#F97316" },
      "violet-bg": { "value": "#EDE9FE" },
      "violet-text": { "value": "#8B5CF6" }
    },
    "surface": {
      "page-bg": { "value": "#EFF2F7", "description": "Light mode body bg" },
      "surface":  { "value": "#F8FAFC", "description": "Content area bg" },
      "border":   { "value": "#E2E8F0", "description": "Standard border" },
      "white":    { "value": "#FFFFFF", "description": "Card/modal/input bg" }
    },
    "verdict": {
      "go":    { "bg": "#DCFCE7", "border": "#86EFAC", "text": "#15803D" },
      "nogo":  { "bg": "#FEE2E2", "border": "#FCA5A5", "text": "#DC2626" },
      "needs": { "bg": "#FEF3C7", "border": "#FDE68A", "text": "#B45309" },
      "none":  { "bg": "#F1F5F9", "border": "#E2E8F0", "text": "#64748B" }
    },
    "chart": {
      "completed": { "value": "#14B8A6" },
      "failed":    { "value": "#FF8A65" },
      "queued":    { "value": "#FBBF24" },
      "track":     { "value": "#F1F5F9" }
    },
    "nav": {
      "inactive":     { "value": "#8BB5CC" },
      "section-label":{ "value": "#4A7090" },
      "active-border":{ "value": "#14B8A6" },
      "mobile-border":{ "value": "#1E3A5F" }
    },
    "dark-mode": {
      "body":         { "value": "#111111" },
      "content":      { "value": "#141414" },
      "card":         { "value": "#1A1A1A" },
      "hover":        { "value": "#222222" },
      "hover-strong": { "value": "#2A2A2A" },
      "border":       { "value": "#333333" }
    }
  },
  "typography": {
    "font-family": {
      "sans": { "value": "'Geist', ui-sans-serif, system-ui, sans-serif" },
      "mono": { "value": "'JetBrains Mono', ui-monospace, monospace" }
    },
    "font-size": {
      "xs":   { "value": "0.75rem",  "px": 12 },
      "sm":   { "value": "0.875rem", "px": 14 },
      "base": { "value": "1rem",     "px": 16 },
      "lg":   { "value": "1.125rem", "px": 18 },
      "xl":   { "value": "1.25rem",  "px": 20 },
      "2xl":  { "value": "1.5rem",   "px": 24 },
      "6xl":  { "value": "3.75rem",  "px": 60 }
    },
    "font-weight": {
      "normal":   { "value": 400 },
      "medium":   { "value": 500 },
      "semibold": { "value": 600 },
      "bold":     { "value": 700 }
    },
    "line-height": {
      "none":    { "value": 1 },
      "tight":   { "value": 1.25 },
      "normal":  { "value": 1.5 },
      "relaxed": { "value": 1.625 }
    }
  },
  "spacing": {
    "1":  { "value": "4px" },
    "2":  { "value": "8px" },
    "3":  { "value": "12px" },
    "4":  { "value": "16px" },
    "5":  { "value": "20px" },
    "6":  { "value": "24px" },
    "8":  { "value": "32px" }
  },
  "border-radius": {
    "sm":   { "value": "4px",   "description": "Logo icon" },
    "btn":  { "value": "8px",   "description": "Buttons, inputs, nav items" },
    "card": { "value": "12px",  "description": "Modals, explicit cards" },
    "lg":   { "value": "16px",  "description": "Main cards (rounded-2xl)" },
    "full": { "value": "9999px","description": "Avatars, badge pills, toggles" }
  },
  "shadows": {
    "sm": { "value": "0 1px 2px 0 rgb(0 0 0 / 0.05)" },
    "lg": { "value": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)" },
    "xl": { "value": "0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1)" },
    "chat": { "value": "0 2px 10px -4px rgba(0, 0, 0, 0.05)" }
  },
  "layout": {
    "sidebar-width": { "value": "256px" },
    "header-height": { "value": "80px" },
    "content-max-width": { "value": "1600px" },
    "settings-max-width": { "value": "672px" },
    "modal-max-width": { "value": "448px" },
    "modal-backdrop": { "value": "rgba(13, 37, 53, 0.6)" }
  },
  "breakpoints": {
    "sm":  { "value": "640px" },
    "md":  { "value": "768px" },
    "lg":  { "value": "1024px" },
    "xl":  { "value": "1280px" },
    "2xl": { "value": "1536px" }
  },
  "icons": {
    "library": "lucide-react",
    "sizes": {
      "nav-desktop":  { "value": 18 },
      "nav-mobile":   { "value": 20 },
      "inline":       { "value": 14 },
      "inline-medium":{ "value": 16 },
      "section-icon": { "value": 16 }
    }
  }
}
